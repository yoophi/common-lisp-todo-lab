(in-package #:todo-api)

(define-condition api-error (error)
  ((status :initarg :status :reader error-status)
   (code :initarg :code :reader error-code)
   (message :initarg :message :reader error-message)
   (headers :initarg :headers :initform nil :reader error-headers)))

(defun fail (status code message &optional headers)
  (error 'api-error :status status :code code :message message :headers headers))

(defun json-object (&rest entries)
  (let ((object (make-hash-table :test 'equal)))
    (loop for (key value) on entries by #'cddr do (setf (gethash key object) value))
    object))

(defun json-response (status body &optional headers)
  (list status (append '(:content-type "application/json; charset=utf-8") headers)
        (list (com.inuoe.jzon:stringify body))))

(defun error-response (status code message &optional headers)
  (json-response status (json-object "error" (json-object "code" code "message" message))
                 headers))

(defun todo-json (row)
  (json-object "id" (getf row :|id|) "title" (getf row :|title|)
               "completed" (= 1 (getf row :|completed|))))

(defun require-todo (row)
  (or row (fail 404 "not_found" "Todo not found.")))

(defun unsigned-integer (value minimum maximum name)
  (unless (and (stringp value) (<= 1 (length value) 19)
               (every (lambda (ch) (find ch "0123456789")) value))
    (fail 400 "invalid_input" (format nil "~A must be an integer." name)))
  (let ((number (parse-integer value)))
    (unless (<= minimum number maximum)
      (fail 400 "invalid_input" (format nil "~A is out of range." name)))
    number))

(defun todo-id (params)
  (unsigned-integer (cdr (assoc :id params)) 1 9223372036854775807 "id"))

(defvar *json-body* nil)

(defun validate-todo-body (&key creating)
  (unless (hash-table-p *json-body*)
    (fail 400 "invalid_input" "The request body must be a JSON object."))
  (maphash (lambda (key value)
             (declare (ignore value))
             (unless (member key '("title" "completed") :test #'string=)
               (fail 400 "invalid_input" "Only title and completed may be supplied.")))
           *json-body*)
  (multiple-value-bind (title title-p) (gethash "title" *json-body*)
    (multiple-value-bind (completed completed-p) (gethash "completed" *json-body*)
      (when (and creating (not title-p))
        (fail 400 "invalid_input" "title is required."))
      (unless (or title-p completed-p)
        (fail 400 "invalid_input" "At least one field must be supplied."))
      (when title-p
        (unless (and (stringp title) (<= 1 (length title) 200)
                     (plusp (length (string-trim '(#\Space #\Tab #\Newline #\Return) title)))
                     (not (find #\Null title)))
          (fail 400 "invalid_input" "title must contain 1 to 200 characters and not be blank.")))
      (when (and completed-p (not (or (eq completed t) (null completed))))
        (fail 400 "invalid_input" "completed must be true or false."))
      (values title title-p completed completed-p))))

(defun read-json-body (env)
  (let* ((content-type (or (getf env :content-type) ""))
         (type (string-trim '(#\Space #\Tab)
                 (subseq content-type 0 (position #\; content-type))))
         (length (getf env :content-length))
         (stream (getf env :raw-body))
         (maximum 65536))
    (unless (string-equal type "application/json")
      (fail 415 "unsupported_media_type" "Content-Type must be application/json."))
    (when (and length (> length maximum))
      (fail 413 "body_too_large" "Request body exceeds 64 KiB."))
    (let ((bytes (make-array 0 :element-type '(unsigned-byte 8)
                              :adjustable t :fill-pointer 0)))
      (when stream
        (loop for index from 0 below (or length (1+ maximum))
              for byte = (read-byte stream nil nil)
              while byte do
                (when (= index maximum)
                  (fail 413 "body_too_large" "Request body exceeds 64 KiB."))
                (vector-push-extend byte bytes)))
      (handler-case
          (com.inuoe.jzon:parse (babel:octets-to-string bytes :encoding :utf-8)
                               :max-depth 16)
        (error () (fail 400 "invalid_json" "Request body must contain valid UTF-8 JSON."))))))

(defun allowed-methods (path)
  (cond ((string= path "/health") '(:get :head))
        ((string= path "/todos") '(:get :head :post))
        ((and (> (length path) 7) (string= "/todos/" path :end2 7)
              (not (position #\/ path :start 7))) '(:get :head :patch :delete))))

(defclass todo-app (ningle:app) ())

(defmethod ningle:make-request ((app todo-app) env)
  (declare (ignore app))
  ;; JSON is parsed once by Jzon in the boundary below, not by Lack's form parser.
  (let ((copy (copy-list env)))
    (setf (getf copy :raw-body) nil (getf copy :content-length) nil)
    (lack.request:make-request copy)))

(defmethod ningle:not-found ((app todo-app))
  (declare (ignore app))
  (error-response 404 "not_found" "Route not found."))

(defun api-boundary (app path)
  (lambda (env)
    (handler-case
        (let* ((*database-path* path)
               (method (getf env :request-method))
               (allowed (allowed-methods (getf env :path-info))))
          (unless allowed (fail 404 "not_found" "Route not found."))
          (unless (member method allowed)
            (fail 405 "method_not_allowed" "Method not allowed."
                  (list :allow (format nil "~{~A~^, ~}" allowed))))
          (let ((*json-body* (when (member method '(:post :patch)) (read-json-body env))))
            (let ((response (lack.component:call app env)))
              ;; Ningle's own request parser can return a plain-text 400.
              (if (= 400 (first response))
                  (error-response 400 "invalid_input" "Invalid request parameters.")
                  response))))
      (api-error (e)
        (error-response (error-status e) (error-code e) (error-message e) (error-headers e)))
      (error (e)
        (format *error-output* "Request failed: ~A~%" e)
        (error-response 500 "internal_error" "An internal error occurred.")))))

(defun configure-routes (app)
  (setf (ningle:route app "/health" :method :get)
        (lambda (params) (declare (ignore params))
          (json-response 200 (json-object "status" "ok"))))
  (setf (ningle:route app "/todos" :method :get)
        (lambda (params)
          (declare (ignore params))
          (let ((query (lack.request:request-query-parameters ningle:*request*)))
            (unless (and (every (lambda (entry) (member (car entry) '("limit" "offset") :test #'string=)) query)
                         (= (length query) (length (remove-duplicates query :key #'car :test #'string=))))
              (fail 400 "invalid_input" "Use limit and offset once each."))
            (let ((limit (unsigned-integer (or (cdr (assoc "limit" query :test #'string=)) "50") 1 100 "limit"))
                  (offset (unsigned-integer (or (cdr (assoc "offset" query :test #'string=)) "0") 0 9223372036854775807 "offset")))
              (json-response 200 (map 'vector #'todo-json (list-todos limit offset)))))))
  (setf (ningle:route app "/todos" :method :post)
        (lambda (params)
          (declare (ignore params))
          (multiple-value-bind (title title-p completed) (validate-todo-body :creating t)
            (declare (ignore title-p))
            (let ((row (create-todo title completed)))
              (json-response 201 (todo-json row)
                             (list :location (format nil "/todos/~D" (getf row :|id|))))))))
  (setf (ningle:route app "/todos/:id" :method :get)
        (lambda (params) (json-response 200 (todo-json (require-todo (get-todo (todo-id params)))))))
  (setf (ningle:route app "/todos/:id" :method :patch)
        (lambda (params)
          (let ((id (todo-id params)))
            (multiple-value-bind (title title-p completed completed-p) (validate-todo-body)
              (json-response 200 (todo-json (require-todo
                (update-todo id title title-p completed completed-p))))))))
  (setf (ningle:route app "/todos/:id" :method :delete)
        (lambda (params)
          (unless (delete-todo (todo-id params)) (fail 404 "not_found" "Todo not found."))
          '(204 () ())))
  app)
