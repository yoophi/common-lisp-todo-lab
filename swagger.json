{
  "openapi": "3.0.3",
  "info": {
    "title": "Common Lisp Todo Lab",
    "version": "0.1.0",
    "description": "Common Lisp + SBCL 개발 학습을 위한 SQLite 기반 Todo RESTful API. 인증 없는 단일 목록을 제공합니다. 후행 슬래시 없는 경로를 사용하세요. 알 수 없는 경로는 404, 지원하지 않는 메서드는 405와 Allow 헤더를 반환합니다. 정상 DELETE 및 모든 HEAD 응답에는 본문이 없습니다."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "로컬 개발 서버 (IPv4). HOST/PORT를 변경한 경우 URL도 변경하세요."
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "서버 상태 확인"
    },
    {
      "name": "Todos",
      "description": "Todo 생성·조회·부분 수정·삭제"
    }
  ],
  "security": [],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getHealth",
        "summary": "서버 상태 확인",
        "responses": {
          "200": {
            "description": "서버가 응답합니다. DB 연결 상태를 검사하는 엔드포인트는 아닙니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "head": {
        "tags": [
          "Health"
        ],
        "operationId": "headHealth",
        "summary": "서버 상태 헤더 확인",
        "description": "GET과 같은 상태 코드 및 헤더를 반환하며 본문은 없습니다.",
        "responses": {
          "200": {
            "description": "정상 응답, 본문 없음"
          },
          "400": {
            "description": "잘못된 요청, 본문 없음"
          },
          "500": {
            "description": "내부 오류, 본문 없음"
          }
        }
      }
    },
    "/todos": {
      "get": {
        "tags": [
          "Todos"
        ],
        "operationId": "listTodos",
        "summary": "Todo 목록 조회",
        "description": "id 오름차순의 배열입니다. 기본 50개, 최대 100개. 결과가 없으면 []입니다. limit/offset 외의 매개변수와 중복 매개변수는 거부합니다. 동시 변경 중 페이지 간 스냅샷 일관성은 보장하지 않습니다.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "페이지 크기. 각 매개변수는 한 번만 지정합니다.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "건너뛸 항목 수. 0~9의 십진 숫자로 지정합니다.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0,
              "maximum": 9223372036854775807,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Todo 배열",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Todo"
                  }
                },
                "example": [
                  {
                    "id": 1,
                    "title": "Common Lisp 공부",
                    "completed": false
                  }
                ]
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "head": {
        "tags": [
          "Todos"
        ],
        "operationId": "headTodos",
        "summary": "Todo 목록 응답 헤더 조회",
        "description": "GET과 같은 상태 코드 및 헤더를 반환하며 본문은 없습니다.",
        "responses": {
          "200": {
            "description": "정상 응답, 본문 없음"
          },
          "400": {
            "description": "잘못된 요청, 본문 없음"
          },
          "500": {
            "description": "내부 오류, 본문 없음"
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "페이지 크기. 각 매개변수는 한 번만 지정합니다.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "건너뛸 항목 수. 0~9의 십진 숫자로 지정합니다.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0,
              "maximum": 9223372036854775807,
              "default": 0
            }
          }
        ]
      },
      "post": {
        "tags": [
          "Todos"
        ],
        "operationId": "createTodo",
        "summary": "Todo 생성",
        "description": "title은 필수입니다. completed를 생략하면 false입니다. 그 외 필드는 거부합니다.",
        "requestBody": {
          "required": true,
          "description": "UTF-8 JSON 객체. 최대 64 KiB, JSON 중첩 깊이 최대 16.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTodo"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성된 Todo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                },
                "example": {
                  "id": 1,
                  "title": "Common Lisp 공부",
                  "completed": false
                }
              }
            },
            "headers": {
              "Location": {
                "description": "생성된 Todo의 상대 경로",
                "schema": {
                  "type": "string"
                },
                "example": "/todos/1"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/todos/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "1~9223372036854775807. 0~9의 십진 숫자 1~19자리로 지정합니다.",
          "schema": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9223372036854775807
          }
        }
      ],
      "get": {
        "tags": [
          "Todos"
        ],
        "operationId": "getTodo",
        "summary": "Todo 단건 조회",
        "responses": {
          "200": {
            "description": "Todo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                },
                "example": {
                  "id": 1,
                  "title": "Common Lisp 공부",
                  "completed": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "head": {
        "tags": [
          "Todos"
        ],
        "operationId": "headTodo",
        "summary": "Todo 단건 응답 헤더 조회",
        "description": "GET과 같은 상태 코드 및 헤더를 반환하며 본문은 없습니다.",
        "responses": {
          "200": {
            "description": "정상 응답, 본문 없음"
          },
          "400": {
            "description": "잘못된 요청, 본문 없음"
          },
          "404": {
            "description": "Todo가 존재하지 않습니다. 본문 없음."
          },
          "500": {
            "description": "내부 오류, 본문 없음"
          }
        }
      },
      "patch": {
        "tags": [
          "Todos"
        ],
        "operationId": "updateTodo",
        "summary": "Todo 부분 수정",
        "description": "title 또는 completed를 하나 이상 지정합니다. 생략한 필드는 유지합니다. completed:false는 완료 해제를 뜻하며 생략과 다릅니다. 잘못된 필드가 하나라도 있으면 변경하지 않습니다. 동일 필드의 동시 수정은 마지막 쓰기가 남습니다.",
        "requestBody": {
          "required": true,
          "description": "UTF-8 JSON 객체. 최대 64 KiB, JSON 중첩 깊이 최대 16.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTodo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정된 Todo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                },
                "example": {
                  "id": 1,
                  "title": "Common Lisp 공부",
                  "completed": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "delete": {
        "tags": [
          "Todos"
        ],
        "operationId": "deleteTodo",
        "summary": "Todo 삭제",
        "description": "이미 삭제됐거나 존재하지 않는 Todo는 404를 반환합니다.",
        "responses": {
          "204": {
            "description": "삭제 완료. 응답 본문 없음."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^(?![ \\t\\r\\n]*$)[^\\u0000]+$",
        "description": "공백·탭·CR·LF만으로 이루어진 문자열과 NUL 문자는 거부합니다. 앞뒤 공백은 보존합니다.",
        "example": "Common Lisp 공부"
      },
      "Todo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "completed"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9223372036854775807,
            "readOnly": true
          },
          "title": {
            "$ref": "#/components/schemas/Title"
          },
          "completed": {
            "type": "boolean"
          }
        },
        "example": {
          "id": 1,
          "title": "Common Lisp 공부",
          "completed": false
        }
      },
      "CreateTodo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "$ref": "#/components/schemas/Title"
          },
          "completed": {
            "type": "boolean",
            "default": false
          }
        },
        "example": {
          "title": "Common Lisp 공부"
        }
      },
      "UpdateTodo": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "title": {
            "$ref": "#/components/schemas/Title"
          },
          "completed": {
            "type": "boolean"
          }
        },
        "example": {
          "completed": false
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_input",
                  "invalid_json",
                  "not_found",
                  "method_not_allowed",
                  "body_too_large",
                  "unsupported_media_type",
                  "internal_error"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "JSON, UTF-8, 필드, ID 또는 쿼리 매개변수가 잘못되었습니다.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "invalid_input",
                "message": "completed must be true or false."
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Todo 또는 경로가 존재하지 않습니다.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "not_found",
                "message": "Todo not found."
              }
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "해당 경로에서 지원하지 않는 메서드입니다.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "method_not_allowed",
                "message": "Method not allowed."
              }
            }
          }
        },
        "headers": {
          "Allow": {
            "description": "지원하는 메서드 목록",
            "schema": {
              "type": "string"
            },
            "example": "GET, HEAD, PATCH, DELETE"
          }
        }
      },
      "PayloadTooLarge": {
        "description": "본문이 65536 바이트(64 KiB)를 초과했습니다.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "body_too_large",
                "message": "Request body exceeds 64 KiB."
              }
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "Content-Type은 application/json이어야 합니다.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "unsupported_media_type",
                "message": "Content-Type must be application/json."
              }
            }
          }
        }
      },
      "InternalError": {
        "description": "내부 처리 오류. 상세 정보는 서버 로그에 기록됩니다.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "internal_error",
                "message": "An internal error occurred."
              }
            }
          }
        }
      }
    }
  }
}
